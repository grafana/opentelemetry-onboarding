#!/usr/bin/env bash
set -euo pipefail

#### BEGINNING OF BOILERPLATE SCRIPT WAITING TO GET THE GUI

# Load environment variables from .env file if it exists
[[ -f .env ]] && source .env

if [[ ! -f ".env" ]]; then
    echo ".env file not found. Entering interactive setup..."
    # Prompt user for Grafana Cloud credentials
    read -p "Grafana Cloud Instance ID (eg: '123456'): " GRAFANA_CLOUD_INSTANCE_ID
    [[ -z "$GRAFANA_CLOUD_INSTANCE_ID" ]] && error "Grafana Cloud Instance ID cannot be empty"
    
    read -p "Grafana Cloud OTLP Endpoint (eg: 'https://otlp-gateway-prod-eu-west-0.grafana.net/otlp'): " GRAFANA_CLOUD_OTLP_ENDPOINT
    [[ -z "$GRAFANA_CLOUD_OTLP_ENDPOINT" ]] && error "Grafana Cloud OTLP Endpoint cannot be empty"
    
    read -p "Grafana Cloud API Key (eg: 'gcp_...'): " GRAFANA_CLOUD_API_KEY
    [[ -z "$GRAFANA_CLOUD_API_KEY" ]] && error "Grafana Cloud API Key cannot be empty"

    # Generate Basic Authentication Header
    BASIC_AUTH_CREDENTIALS_CLEAR_TEXT="${GRAFANA_CLOUD_INSTANCE_ID}:${GRAFANA_CLOUD_API_KEY}"
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        GRAFANA_CLOUD_BASIC_AUTH_HEADER=$(echo -n "${BASIC_AUTH_CREDENTIALS_CLEAR_TEXT}" | base64 -w 0)
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        GRAFANA_CLOUD_BASIC_AUTH_HEADER=$(echo -n "${BASIC_AUTH_CREDENTIALS_CLEAR_TEXT}" | /usr/bin/base64 --break=0)
    else
        error "Unsupported OS for base64 encoding"
    fi

    # Ask if user wants to save to .env file
    read -p "Save credentials to .env file? (y/n): " SAVE_TO_ENV
    if [[ "$SAVE_TO_ENV" == "y" || "$SAVE_TO_ENV" == "Y" ]]; then
        # Save to .env file
        {
            echo "export GRAFANA_CLOUD_INSTANCE_ID=\"${GRAFANA_CLOUD_INSTANCE_ID}\""
            echo "export GRAFANA_CLOUD_OTLP_ENDPOINT=\"${GRAFANA_CLOUD_OTLP_ENDPOINT}\""
            echo "export GRAFANA_CLOUD_API_KEY=\"${GRAFANA_CLOUD_API_KEY}\""
            echo "export GRAFANA_CLOUD_BASIC_AUTH_HEADER=\"Basic ${GRAFANA_CLOUD_BASIC_AUTH_HEADER}\""
        } >> .env
        echo ".env file created successfully."
    fi
fi

# Verify all required credentials are set
[[ -z "${GRAFANA_CLOUD_INSTANCE_ID:-}" ]] && error "GRAFANA_CLOUD_INSTANCE_ID is not set"
[[ -z "${GRAFANA_CLOUD_OTLP_ENDPOINT:-}" ]] && error "GRAFANA_CLOUD_OTLP_ENDPOINT is not set"
[[ -z "${GRAFANA_CLOUD_API_KEY:-}" ]] && error "GRAFANA_CLOUD_API_KEY is not set"
[[ -z "${GRAFANA_CLOUD_BASIC_AUTH_HEADER:-}" ]] && error "GRAFANA_CLOUD_BASIC_AUTH_HEADER is not set"

echo ""
echo "Collecting deployment configuration..."
echo ""

read -p "Kubernetes Cluster Name (default: 'my_k8s_cluster'): " K8S_CLUSTER_NAME
export K8S_CLUSTER_NAME=${K8S_CLUSTER_NAME:-my_k8s_cluster}

read -p "Deployment Environment Name like 'production', 'staging'... (default: 'production'): " DEPLOYMENT_ENVIRONMENT_NAME
export DEPLOYMENT_ENVIRONMENT_NAME=${DEPLOYMENT_ENVIRONMENT_NAME:-production}

read -p "OpenTelemetry Operator Certificate Source (supported values: 'cert-manager', 'self-signed'; default: 'self-signed'): " OTEL_OPERATOR_CERTIFICATE_SOURCE
export OTEL_OPERATOR_CERTIFICATE_SOURCE=${OTEL_OPERATOR_CERTIFICATE_SOURCE:-self-signed}

# Validate certificate source
case "$OTEL_OPERATOR_CERTIFICATE_SOURCE" in
    self-signed)
        OTEL_OPERATOR_CERT_MANAGER_ENABLED="false"
        ;;
    cert-manager)
        OTEL_OPERATOR_CERT_MANAGER_ENABLED="true"
        ;;
    *)
        error "Invalid OpenTelemetry Operator Certificate Source: '$OTEL_OPERATOR_CERTIFICATE_SOURCE'. Supported values: 'self-signed', 'cert-manager'"
        ;;
esac

echo ""


#### BEGINNING OF INSTALLATION SCRIPT

# IN THE GUI, THE USER WOULD HAVE ENTERED THROUGH THE FOLLOWING DATA
# export GRAFANA_CLOUD_INSTANCE_ID="123456"
# export GRAFANA_CLOUD_API_KEY="gcp_XXXXXXXXXXXXXXXXXXXX"
# export GRAFANA_CLOUD_OTLP_ENDPOINT="https://otlp-gateway-prod-eu-west-0.grafana.net/otlp"
# export K8S_CLUSTER_NAME="my_k8s_cluster"
# export DEPLOYMENT_ENVIRONMENT_NAME="production"
# export CERTIFICATE_SOURCE="kube-cert-manager" # options: "kube-cert-manager", "auto-generate"

# WARNING: dont change "namespace=opentelemetry-operator-system" as it is used in the 'instrumentation' CRD defined in values.yaml

# TODO
# - REQUIRED: Add support for both certificate sources: 1) from Kube Sert Manager, 2) auto generate certs
# - NICE TO HAVE: Add Kubernetes provider handling in the pipeline to get `k8s.cluster.name`, `host.id`, `cloud.*``, requires user to indicate which provider they are using (EKS, GKE, AKS, etc)

echo "Installing OpenTelemetry Kube Stack Helm Chart..."

kubectl create namespace opentelemetry-operator-system || echo "WARNING: Could not create namespace 'opentelemetry-operator-system' (may already exist or insufficient permissions). Continuing..."

kubectl create secret generic grafana-cloud-auth \
  --namespace opentelemetry-operator-system  \
  --from-literal=GRAFANA_CLOUD_INSTANCE_ID="$GRAFANA_CLOUD_INSTANCE_ID" \
  --from-literal=GRAFANA_CLOUD_OTLP_ENDPOINT="$GRAFANA_CLOUD_OTLP_ENDPOINT" \
  --from-literal=GRAFANA_CLOUD_API_KEY="$GRAFANA_CLOUD_API_KEY" \
  --from-literal=GRAFANA_CLOUD_BASIC_AUTH_HEADER="$GRAFANA_CLOUD_BASIC_AUTH_HEADER" \
  || echo "WARNING: Could not create secret 'grafana-cloud-auth' (may already exist or insufficient permissions). Continuing..."

helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts
helm repo update

helm upgrade opentelemetry-stack \
    open-telemetry/opentelemetry-kube-stack \
    --version 0.12.7 \
    --install \
    --namespace opentelemetry-operator-system \
    --set opentelemetry-operator.admissionWebhooks.certManager.enabled=$OTEL_OPERATOR_CERT_MANAGER_ENABLED \
    --set-string clusterName=$K8S_CLUSTER_NAME \
    --set-string instrumentation.resource.resourceAttributes.deployment\\.environment\\.name=$DEPLOYMENT_ENVIRONMENT_NAME \
    -f https://raw.githubusercontent.com/grafana/opentelemetry-onboarding/refs/heads/main/kubernetes/otel-kube-stack-helm-chart/values.yaml

echo ""
echo "✓ OpenTelemetry Kube Stack installed successfully!"
echo ""
echo "Next steps:"
echo "  - Send OTLP to: http://opentelemetry-stack-daemon-collector.opentelemetry-operator-system.svc.cluster.local:4318 (HTTP/Protobuf)"
echo "  - Auto-instrument pods by adding this annotation:"
echo "    instrumentation.opentelemetry.io/inject-<language>: opentelemetry-operator-system/otel-instrumentation"